FROM ubuntu:22.04
LABEL org.opencontainers.image.source="https://github.com/Charly-chan/SWE-Game"
LABEL org.gamebench.agent.mode="godot"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG NODE_VERSION=22.22.0
ARG GODOT_URL=https://github.com/godotengine/godot/releases/download/4.5.1-stable/Godot_v4.5.1-stable_linux.x86_64.zip

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl unzip xz-utils git git-lfs jq ripgrep \
    python3 python3-venv python3-pip \
    xvfb xauth ffmpeg fonts-dejavu-core fonts-liberation \
    libgl1 libgl1-mesa-dri libglu1-mesa libegl1 libgbm1 libvulkan1 mesa-vulkan-drivers \
    libx11-6 libxcursor1 libxinerama1 libxrandr2 libxi6 libxkbcommon0 \
    libasound2 libpulse0 libfontconfig1 libdbus-1-3 libudev1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl --retry 5 --retry-delay 3 --connect-timeout 30 -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      | tar -xJ --strip-components=1 -C /usr/local

# npm can abort halfway through the large native CLI tarballs. Retry once using
# the download cache from that attempt; keep the completed Node layer reusable.
RUN for attempt in 1 2; do \
      npm install --prefix /opt/gamebench-tools --no-fund --no-audit --omit=dev \
        --fetch-retries=5 \
        @anthropic-ai/claude-code@2.1.222 @anthropic-ai/claude-code-linux-x64@2.1.222 \
        @openai/codex@0.153.4 @openai/codex-linux-x64@npm:@openai/codex@0.153.4-linux-x64 \
      && break; \
      test "$attempt" -lt 2 || exit 1; \
    done \
    && ln -s /opt/gamebench-tools/node_modules/.bin/claude /usr/local/bin/claude \
    && ln -s /opt/gamebench-tools/node_modules/.bin/codex /usr/local/bin/codex \
    && npm cache clean --force

COPY requirements.txt /tmp/gamebench-requirements.txt
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --timeout 120 --retries 8 -r /tmp/gamebench-requirements.txt \
    && rm /tmp/gamebench-requirements.txt

RUN curl --retry 5 --retry-delay 3 --connect-timeout 30 -fsSL "$GODOT_URL" -o /tmp/godot.zip \
    && unzip -q /tmp/godot.zip -d /tmp/godot \
    && install -m 0755 /tmp/godot/Godot_v4.5.1-stable_linux.x86_64 /usr/local/bin/godot \
    && rm -rf /tmp/godot.zip /tmp/godot

ENV PATH="/opt/venv/bin:${PATH}" \
    GODOT_BIN=/usr/local/bin/godot \
    GB_PYTHON=/opt/venv/bin/python3
RUN useradd --create-home --uid 1000 --shell /bin/bash agent \
    && mkdir /workspace && chown agent:agent /workspace
USER agent
WORKDIR /workspace
CMD ["bash"]
