  "interface": {
    "extended_actions": [
      {
        "id": "turn_left",
        "why": "the six canonical verbs contain no turn; movement is camera-relative (player.gd builds direction from neck.global_transform.basis) and interaction is an aimed eye-height ray, so a route that cannot yaw can only ever face its spawn heading"
      },
      {
        "id": "turn_right",
        "why": "the six canonical verbs contain no turn; movement is camera-relative (player.gd builds direction from neck.global_transform.basis) and interaction is an aimed eye-height ray, so a route that cannot yaw can only ever face its spawn heading"
      },
      {
        "id": "turn_up",
        "why": "the six canonical verbs contain no pitch; the interaction ray starts level and the Virus, Keycard, Checkpoint01 and Door11Switch interaction points sit 34-55 degrees below it, so without pitch the ray misses four of the seven objectives outright"
      },
      {
        "id": "turn_down",
        "why": "the six canonical verbs contain no pitch; the interaction ray starts level and the Virus, Keycard, Checkpoint01 and Door11Switch interaction points sit 34-55 degrees below it, so without pitch the ray misses four of the seven objectives outright"
      }
    ],
