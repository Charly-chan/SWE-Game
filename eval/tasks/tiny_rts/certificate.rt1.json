        "id": "cmd_build_menu",
        "why": "B opens placement; no battlefield ships a blue barracks and no canonical verb toggles the menu"
      },
      {
        "id": "cmd_gather",
        "why": "G sends idle pawns to veins from anywhere; Space-gather is range-gated and loses to the build-site branch"
      },
      {
        "id": "cmd_rally",
        "why": "T forms the army on the commander; Space with military selected attacks the nearest escort instead"
      }
