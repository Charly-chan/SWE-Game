      },
      {
        "id": "cmd_slot_4",
        "why": "digit 4 selects the whole military pool so siege orders the army together, not one cycled unit"
      },
      {
        "id": "cmd_train_pawn",
        "why": "Z trains a pawn from the keep; six verbs have no training verb and extra sappers are the demolition half of a raze"
      },
      {
        "id": "cmd_train_warrior",
        "why": "X trains a warrior, the only unit that can hold the home keep against a Bannerfall raid; the archer line trained by C keeps its range by not being the thing being hit"
      },
      {
        "id": "cmd_train_archer",
        "why": "C trains an archer, the only unit whose 300px range matches red archers and sits outside the tower reply"
      },
      {
        "id": "cmd_siege",
        "why": "V points the selection at the nearest enemy building; gb_action always resolves onto the nearer escort unit"
