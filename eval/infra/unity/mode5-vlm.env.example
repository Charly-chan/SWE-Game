# Copy the variable names into the host evaluator environment.
# Never commit a real key or put it inside the Unity VM.
GAMEBENCH_VLM_PROVIDER=responses
GAMEBENCH_VLM_MODEL=gpt-5.6
GAMEBENCH_VLM_KEY_ENV=OPENAI_API_KEY
# Optional compatible endpoint:
# GAMEBENCH_VLM_BASE_URL=https://api.openai.com/v1
