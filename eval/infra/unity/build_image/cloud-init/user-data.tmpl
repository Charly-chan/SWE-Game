#cloud-config
hostname: gb-unity-builder
manage_etc_hosts: true
timezone: UTC
locale: C.UTF-8
disable_root: true
ssh_pwauth: false

users:
  - name: gb-admin
    gecos: GameBench image builder
    groups: [adm, sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - @@SSH_PUBLIC_KEY@@
  - name: unity-runner
    gecos: Unprivileged Unity evaluator
    shell: /bin/bash
    lock_passwd: true
  - name: gb-controller
    gecos: Unprivileged evaluator controller
    shell: /bin/bash
    lock_passwd: true

package_update: true
packages:
  - apparmor-utils
  - auditd
  - ca-certificates
  - curl
  - ffmpeg
  - git
  - jq
  - libasound2t64
  - libatk1.0-0t64
  - libc6
  - libcairo2
  - libcap2-bin
  - libdbus-1-3
  - libdrm2
  - libfontconfig1
  - libfreetype6
  - libgcc-s1
  - libgbm1
  - libgl1
  - libgl1-mesa-dri
  - libglib2.0-0t64
  - libglu1-mesa
  - libgtk-3-0t64
  - libnss3
  - libpango-1.0-0
  - libstdc++6
  - libx11-6
  - libx11-xcb1
  - libxcb1
  - libxcursor1
  - libxext6
  - libxi6
  - libxinerama1
  - libxrandr2
  - libxrender1
  - libxss1
  - libxtst6
  - mesa-utils
  - openssh-server
  - python3
  - python3-venv
  - qemu-guest-agent
  - unzip
  - xauth
  - xdg-utils
  - xserver-xorg-video-dummy
  - xvfb
  - xz-utils

write_files:
  - path: /etc/gamebench/environment-class
    owner: root:root
    permissions: '0644'
    content: |
      local-qemu-whpx-image-build
      score_eligible=false

runcmd:
  - [systemctl, enable, --now, ssh]
  - [install, -d, -m, '0755', -o, root, -g, root, /opt/unity]
  - [install, -d, -m, '0700', -o, unity-runner, -g, unity-runner, /var/lib/gamebench/scratch]
  - [install, -d, -m, '0700', -o, gb-controller, -g, gb-controller, /var/lib/gamebench/controller]
  - [install, -d, -m, '0750', -o, gb-controller, -g, gb-controller, /var/lib/gamebench/output]

final_message: GameBench Ubuntu image-builder bootstrap complete
